// Prisma Schema for Luxury E-Commerce Store
// Compatible with PostgreSQL (Supabase / Neon / Vercel Postgres / AWS RDS) and SQLite for local development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING_VERIFICATION
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  image       String
  featured    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  tagline          String?
  description      String
  details          String           // JSON string of array
  careInstructions String?          // JSON string of array
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subCategory      String?
  gender           Gender           @default(UNISEX)
  basePricePKR     Float
  basePriceUSD     Float
  originalPricePKR Float?
  originalPriceUSD Float?
  featured         Boolean          @default(false)
  isNewArrival     Boolean          @default(false)
  isBestSeller     Boolean          @default(false)
  inStock          Boolean          @default(true)
  rating           Float            @default(5.0)
  reviewsCount     Int              @default(0)
  tags             String           // Comma separated
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId])
  @@index([slug])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String      @unique
  size            String?
  color           String?
  colorHex        String?
  stock           Int         @default(0)
  priceAdjustment Float       @default(0)
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([sku])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerName  String
  customerEmail String
  customerPhone String
  addressLine1  String
  addressLine2  String?
  city          String
  stateProvince String?
  postalCode    String?
  country       String
  currency      String        @default("PKR")
  subtotal      Float
  shippingCost  Float         @default(0)
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PENDING_VERIFICATION)
  trackingNumber String?
  courierName   String?
  notes         String?
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([customerPhone])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  productImage String
  sku        String
  size       String?
  color      String?
  price      Float
  quantity   Int
}

model Review {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName    String
  verifiedBuyer Boolean  @default(true)
  rating        Int      @default(5)
  comment       String
  location      String?
  createdAt     DateTime @default(now())
}

model StoreSettings {
  id                       String   @id @default("global-settings")
  brandName                String   @default("MAISON ATELIER")
  tagline                  String   @default("Timeless Design. Modern Essence.")
  freeShippingThresholdPKR Float    @default(7500)
  freeShippingThresholdUSD Float    @default(150)
  standardShippingPKR      Float    @default(299)
  standardShippingUSD      Float    @default(15)
  contactEmail             String   @default("concierge@maisonatelier.com")
  contactPhone             String   @default("+92 42 3578 9900")
  whatsappNumber           String   @default("+923001234567")
  updatedAt                DateTime @updatedAt
}
